{
  "extends": "./.hutch/devkit/tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    // `paths` replaces the devkit's whole map rather than merging with it, and the devkit's `baseUrl` would otherwise
    // anchor these entries inside .hutch/devkit, so this config sets its own base and repeats the SDK entries it imports.
    "baseUrl": ".",
    "paths": {
      "electrobun": ["./.hutch/devkit/api/sdks/main/index.ts"],
      "electrobun/main": ["./.hutch/devkit/api/sdks/main/index.ts"],
      "electrobun/main/*": ["./.hutch/devkit/api/sdks/main/entries/*"],
      "strata": ["../../../strata/index.ts"],
      "strata/testing": ["../../../strata/testing.ts"]
    }
  },
  "include": ["main.ts", "trial-main.ts", "server.ts", "host.ts", "workspace-store.ts", "workspace-close.ts", "check-worker.ts", "check-runner.ts", "build.ts", "prepare-build-tools.ts", "electrobun.config.ts", "prepare-static.ts", "release.ts", "notices.ts", "host-log.ts", "webview2.ts", "startup-watchdog.ts", "prepare-webview2.ts", "webview2-install.ts", "verify-canary.ts", "build-installer.ts", "package-content-scan.ts", "runtime-capabilities.ts", "devkit-check.ts", "tools/sandbox-trial.ts", "tools/measure-installed-start.ts", "tests/*.ts"]
}

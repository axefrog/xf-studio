{
  "kind": "process",
  "id": "file-export",
  "owner": "platform",
  "summary": "Serialising a node to a file and handing it to the person to save.",
  "status": "target",
  "driver": "driver:files",
  "work": "Serialises the target in its portable form and sends it to the download sink.",
  "progress": {
    "type": "null"
  },
  "result": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string"
      },
      "bytes": {
        "type": "integer",
        "minimum": 0
      }
    },
    "required": [
      "name",
      "bytes"
    ]
  },
  "failure": {
    "allOf": [
      {
        "$ref": "shapes.schema.json#/$defs/fault"
      },
      {
        "type": "object",
        "properties": {
          "code": {
            "enum": [
              "not-exportable"
            ]
          }
        }
      }
    ]
  },
  "cancel": "The token is aborted; nothing else runs.",
  "cleanup": "The object URL is revoked.",
  "deadline": 10000,
  "lane": "page, the person's own"
}

{
  "kind": "process",
  "id": "report-prepare",
  "owner": "diagnostics",
  "summary": "Preparing a Report a problem archive locally; it is never sent.",
  "status": "target",
  "driver": "driver:diagnostics",
  "work": "Collects the included items, redacts private paths and zips them.",
  "progress": {
    "$ref": "shapes.schema.json#/$defs/percent"
  },
  "result": {
    "type": "object",
    "properties": {
      "file": {
        "$ref": "shapes.schema.json#/$defs/blob"
      },
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "required": [
      "file",
      "items"
    ]
  },
  "failure": {
    "allOf": [
      {
        "$ref": "shapes.schema.json#/$defs/fault"
      },
      {
        "type": "object",
        "properties": {
          "code": {
            "enum": [
              "too-large"
            ]
          }
        }
      }
    ]
  },
  "cancel": "The token is aborted; nothing else runs.",
  "cleanup": "The partial archive is dropped.",
  "deadline": 30000,
  "lane": "host, the person's own"
}

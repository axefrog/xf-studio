{
  "kind": "process",
  "id": "update-check",
  "owner": "desktop",
  "summary": "Checking the update feed.",
  "status": "target",
  "driver": "driver:updates",
  "work": "Reads the feed for the configured channel.",
  "progress": {
    "type": "null"
  },
  "result": {
    "type": "object",
    "properties": {
      "available": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "required": [
      "available"
    ]
  },
  "failure": {
    "allOf": [
      {
        "$ref": "shapes.schema.json#/$defs/fault"
      },
      {
        "type": "object",
        "properties": {
          "code": {
            "enum": [
              "network"
            ]
          }
        }
      }
    ]
  },
  "cancel": "The token is aborted; nothing else runs.",
  "cleanup": "Nothing to clean up.",
  "deadline": 15000,
  "lane": "desktop, background"
}

{
  "kind": "source",
  "id": "host-processes",
  "owner": "host",
  "summary": "Child processes the host runs (WolvenKit, the builder, the Python oracle, registry and task queries, the file browser, the WebView2 installer, Oodle) and their output and exit.",
  "status": "both",
  "replaces": [
    "desktop-app-host",

          "stdout",
          "stderr",
          "exit",
          "spawned"
        ]
      },
      "text": {
        "type": "string"
      },
      "code": {
        "type": "integer"
      }
    },
    "required": [
      "process",
      "kind"
    ]
  },
  "adapter": "planned",
  "simulated": "../../../strata/src/testing/sim-sources",
  "rate": "One per run; output streamed while it runs."

    "facial-host",
    "install-detection-host",
    "mod-install-host",
    "native/oodle",
    "process-tree",
    "wolvenkit-cli"
  ],
  "environment": "host",
  "entry": {
    "type": "object",
    "properties": {
      "process": {
        "type": "string"
      },
      "kind": {

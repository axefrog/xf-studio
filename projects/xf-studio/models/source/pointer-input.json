{
  "kind": "source",
  "id": "pointer-input",
  "owner": "platform",
  "summary": "Pointer presses, moves and releases over a view's canvas or a panel, in that element's coordinates.",
  "status": "both",
  "replaces": [
    "browser-viewport-device",
    "head-camera-input",
    "surface-editor",
    "uv-editor",
    "viewport-attachment"
  ],
  "environment": "page",
  "entry": {
    "type": "object",
    "properties": {
      "window": {
        "type": "string"
      },
      "target": {
        "type": "string"
      },
      "kind": {
        "enum": [
          "down",
          "move",
          "up",
          "cancel",
          "enter",
          "leave"
        ]
      },
      "x": {
        "type": "number"
      },
      "y": {
        "type": "number"
      },
      "buttons": {
        "type": "integer",
        "minimum": 0
      },
      "pointer": {
        "type": "integer",
        "minimum": 0
      }
    },
    "required": [
      "window",
      "target",
      "kind",
      "x",
      "y",
      "buttons",
      "pointer"
    ]
  },
  "adapter": "planned",
  "simulated": "../../../strata/src/testing/sim-sources",
  "rate": "Hundreds per second while moving; coalesced to the latest per frame and never kept.",
  "x-friction": [
    {
      "gap": "Pointer moves must collapse to the latest per animation frame and not start a cycle unless something consumes them.",
      "capability": "frame-timing",
      "closes": "Frame-coalesced input sources with no ring."
    }
  ]
}

{
  "kind": "operator",
  "id": "experiment-enabled",
  "owner": "platform",
  "summary": "Resolve a registered experiment preference and an isolated verification URL override.",
  "status": "target",
  "nodeKind": "combinator",
  "params": {
    "type": "object",
    "properties": {
      "experiment": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "experiment"
    ],
    "additionalProperties": false
  },
  "inputs": [
    "type:experimental-features",
    "source:page-location"
  ],
  "output": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean"
      },
      "origin": {
        "enum": [
          "default",
          "preference",
          "verification"
        ]
      }
    },
    "required": [
      "enabled",
      "origin"
    ],
    "additionalProperties": false
  },
  "pure": true,
  "x-contract": "Absent and unknown experiment IDs are off. Only verify=1 accepts experiment.<id>=1 or 0; override never persists. Invalid or duplicate override values are ignored."
}

{
  "kind": "request",
  "id": "load-experiment",
  "owner": "platform",
  "summary": "Maintain a registered experiment contribution only while its effective opt-in remains enabled.",
  "status": "target",
  "goal": {
    "type": "object",
    "properties": {
      "experiment": {
        "type": "string",
        "minLength": 1
      },
      "registered": {
        "const": true
      }
    },
    "required": [
      "experiment",
      "registered"
    ],
    "additionalProperties": false
  },
  "accepts": {
    "type": "object",
    "properties": {
      "window": {
        "$ref": "shapes.schema.json#/$defs/nodeRef"
      },
      "settings": {
        "$ref": "shapes.schema.json#/$defs/nodeRef"
      },
      "experiment": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "window",
      "settings",
      "experiment"
    ],
    "additionalProperties": false
  },
  "reasons": [
    "person",
    "maintains"
  ],
  "servedBy": [
    "driver:experiment"
  ],
  "key": [
    "window",
    "experiment"
  ],
  "deadline": 1000,
  "linger": 0,
  "root": true,
  "faults": [
    {
      "code": "experiment-load-failed",
      "when": "The optional module could not be loaded; leave the regular Studio working and offer Try again.",
      "fault": "owner",
      "goesTo": "person",
      "then": "fail"
    }
  ],
  "x-root": "The person enables an experiment or opens a workspace with that experiment enabled; its root-window lifetime owns the request."
}

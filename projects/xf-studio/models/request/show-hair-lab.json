{
  "kind": "request",
  "id": "show-hair-lab",
  "owner": "hair-lab",
  "summary": "Show matching diagnostic groom geometry in one active character scene.",
  "status": "target",
  "goal": {
    "type": "object",
    "properties": {
      "identity": {
        "type": "object",
        "properties": {
          "groom": {
            "$ref": "shapes.schema.json#/$defs/nodeRef"
          },
          "scene": {
            "$ref": "shapes.schema.json#/$defs/nodeRef"
          },
          "character": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "surface": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "groom",
          "scene",
          "character",
          "revision",
          "surface"
        ],
        "additionalProperties": false
      },
      "quality": {
        "enum": [
          "coarse",
          "refined"
        ]
      }
    },
    "required": [
      "identity",
      "quality"
    ],
    "additionalProperties": false
  },
  "accepts": {
    "type": "object",
    "properties": {
      "session": {
        "$ref": "shapes.schema.json#/$defs/nodeRef"
      },
      "groom": {
        "$ref": "shapes.schema.json#/$defs/nodeRef"
      },
      "scene": {
        "$ref": "shapes.schema.json#/$defs/nodeRef"
      },
      "revision": {
        "type": "integer",
        "minimum": 0
      }
    },
    "required": [
      "session",
      "groom",
      "scene",
      "revision"
    ],
    "additionalProperties": false
  },
  "reasons": [
    "shows",
    "person"
  ],
  "servedBy": [
    "driver:hair-lab"
  ],
  "key": [
    "session",
    "scene"
  ],
  "deadline": 1000,
  "linger": 0,
  "root": true,
  "faults": [
    {
      "code": "invalid-groom",
      "when": "The graph or its field expressions cannot be evaluated.",
      "fault": "requester",
      "goesTo": "person",
      "then": "fail"
    },
    {
      "code": "scalp-unavailable",
      "when": "No usable scalp can be derived for this character.",
      "fault": "owner",
      "goesTo": "person",
      "then": "fail"
    },
    {
      "code": "generation-failed",
      "when": "The worker or diagnostic renderer failed.",
      "fault": "owner",
      "goesTo": "person",
      "then": "fail"
    }
  ],
  "x-root": "The person activates Hair Lab or edits its bound document; the scene driver maintains the request while its scene and lab are visible."
}

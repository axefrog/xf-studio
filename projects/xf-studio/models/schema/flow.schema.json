{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flow.schema.json",
  "title": "A flow model",
  "type": "object",
  "additionalProperties": false,
  "patternProperties": {
    "^x-": {}
  },
  "required": [
    "kind",
    "id",
    "owner",
    "summary",
    "status",
    "steps",
    "demand",
    "faults",
    "budget",
    "invariants"
  ],
  "properties": {
    "kind": {
      "const": "flow"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "owner": {
      "$ref": "common.schema.json#/$defs/owner"
    },
    "summary": {
      "$ref": "common.schema.json#/$defs/summary"
    },
    "status": {
      "$ref": "common.schema.json#/$defs/status"
    },
    "replaces": {
      "$ref": "common.schema.json#/$defs/replaces"
    },
    "steps": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model",
          "does"
        ],
        "properties": {
          "model": {
            "$ref": "common.schema.json#/$defs/ref"
          },
          "does": {
            "$ref": "common.schema.json#/$defs/text"
          }
        }
      }
    },
    "demand": {
      "$ref": "common.schema.json#/$defs/text"
    },
    "faults": {
      "$ref": "common.schema.json#/$defs/faults"
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latency",
        "memory"
      ],
      "properties": {
        "latency": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.schema.json#/$defs/text"
          }
        },
        "memory": {
          "$ref": "common.schema.json#/$defs/text"
        }
      }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/text"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "both"
          }
        }
      },
      "then": {
        "required": [
          "replaces"
        ],
        "properties": {
          "replaces": {
            "minItems": 1
          }
        }
      }
    }
  ]
}

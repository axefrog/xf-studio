{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "panel.schema.json",
  "title": "A panel model",
  "type": "object",
  "additionalProperties": false,
  "patternProperties": {
    "^x-": {}
  },
  "required": [
    "kind",
    "id",
    "owner",
    "summary",
    "status",
    "binding",
    "reads",
    "actions"
  ],
  "properties": {
    "kind": {
      "const": "panel"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "owner": {
      "$ref": "common.schema.json#/$defs/owner"
    },
    "summary": {
      "$ref": "common.schema.json#/$defs/summary"
    },
    "status": {
      "$ref": "common.schema.json#/$defs/status"
    },
    "replaces": {
      "$ref": "common.schema.json#/$defs/replaces"
    },
    "binding": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(type):[a-z0-9]+(-[a-z0-9]+)*$"
        },
        {
          "$ref": "common.schema.json#/$defs/text"
        }
      ]
    },
    "reads": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "$ref": "common.schema.json#/$defs/ref"
          },
          {
            "$ref": "common.schema.json#/$defs/text"
          }
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(action):[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "both"
          }
        }
      },
      "then": {
        "required": [
          "replaces"
        ],
        "properties": {
          "replaces": {
            "minItems": 1
          }
        }
      }
    }
  ]
}

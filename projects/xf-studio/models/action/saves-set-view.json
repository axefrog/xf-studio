{
  "kind": "action",
  "id": "saves-set-view",
  "owner": "save-explorer",
  "summary": "Set view (saves): changes the open save's view (saves.setView).",
  "status": "both",
  "replaces": [
    "features/save-explorer/actions"
  ],
  "name": "saves.setView",
  "target": "type:open-save",
  "input": {
    "type": "object",
    "properties": {
      "view": {
        "type": "string"
      }
    },
    "required": [
      "view"
    ],
    "additionalProperties": false
  },
  "capability": {
    "when": "The saves folder is known.",
    "refusals": [
      {
        "code": "folder-missing",
        "reason": "Choose where your saves are in Settings › Saves."
      }
    ]
  },
  "effect": {
    "session": "Changes the open save's view (saves.setView)."
  },
  "undo": "none"
}

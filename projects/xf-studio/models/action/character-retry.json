{
  "kind": "action",
  "id": "character-retry",
  "owner": "character",
  "summary": "Retry (character): raises the prepare-v request.",
  "status": "both",
  "replaces": [
    "character-context-actions",
    "character-context"
  ],
  "name": "character.retry",
  "target": "type:v",
  "input": {
    "type": "object",
    "properties": {},
    "required": [],
    "additionalProperties": false
  },
  "capability": {
    "when": "A V is focused and the installation's creator catalogue for her body is built.",
    "refusals": [
      {
        "code": "catalogue-unavailable",
        "reason": "The character creator's choices aren't ready yet."
      },
      {
        "code": "not-offered",
        "reason": "This installation doesn't offer that choice."
      }
    ]
  },
  "effect": {
    "raises": "request:prepare-v"
  },
  "undo": "none"
}

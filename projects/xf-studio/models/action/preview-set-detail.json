{
  "kind": "action",
  "id": "preview-set-detail",
  "owner": "views",
  "summary": "Set detail (preview): sets the display's key (preview.setDetail).",
  "status": "both",
  "replaces": [
    "preview-actions",
    "preview-view-graph"
  ],
  "name": "preview.setDetail",
  "target": "type:display",
  "input": {
    "type": "object",
    "properties": {
      "detail": {
        "enum": [
          "brows",
          "lashes"
        ]
      },
      "enabled": {
        "type": "boolean"
      },
      "view": {
        "type": "string"
      }
    },
    "required": [
      "detail",
      "enabled"
    ],
    "additionalProperties": false
  },
  "capability": {
    "when": "The view exists."
  },
  "effect": {
    "commit": "Sets the display's key (preview.setDetail)."
  },
  "undo": "view-lighting"
}

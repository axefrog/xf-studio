{
  "kind": "action",
  "id": "part-preset-set-list",
  "owner": "expressions",
  "summary": "List (part preset set): raises the list-library reques.",
  "status": "both",
  "replaces": [
    "part-presets",
    "part-preset-sets"
  ],
  "name": "partPresetSet.list",
  "target": "type:mod",
  "input": {
    "type": "object",
    "properties": {
      "feature": {
        "type": "string"
      }
    },
    "required": [
      "feature"
    ],
    "additionalProperties": false
  },
  "capability": {
    "when": "The library is reachable and the set exists.",
    "refusals": [
      {
        "code": "stale",
        "reason": "The set changed elsewhere; reload it first."
      }
    ]
  },
  "effect": {
    "raises": "request:list-library"
  },
  "undo": "none"
}

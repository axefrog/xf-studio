{
  "kind": "action",
  "id": "preview-setup-install-wolven-kit",
  "owner": "setup",
  "summary": "Install wolven kit (preview setup): raises the set-up-wolvenkit request.",
  "status": "both",
  "replaces": [
    "preview-setup"
  ],
  "name": "previewSetup.installWolvenKit",
  "target": "type:window",
  "input": {
    "type": "object",
    "properties": {
      "version": {
        "type": "string"
      }
    },
    "required": [
      "version"
    ],
    "additionalProperties": false
  },
  "capability": {
    "when": "The setup card or the head pane is shown."
  },
  "effect": {
    "raises": "request:set-up-wolvenkit"
  },
  "undo": "none"
}

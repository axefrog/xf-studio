{
  "kind": "action",
  "id": "part-preset-set-build",
  "owner": "expressions",
  "summary": "Build (part preset set): raises the build-mod reques.",
  "status": "both",
  "replaces": [
    "part-presets",
    "part-preset-sets"
  ],
  "name": "partPresetSet.build",
  "target": "type:mod",
  "input": {
    "type": "object",
    "properties": {
      "feature": {
        "type": "string"
      },
      "id": {
        "type": "string"
      }
    },
    "required": [
      "feature",
      "id"
    ],
    "additionalProperties": false
  },
  "capability": {
    "when": "The library is reachable and the set exists.",
    "refusals": [
      {
        "code": "stale",
        "reason": "The set changed elsewhere; reload it first."
      }
    ]
  },
  "effect": {
    "raises": "request:build-mod"
  },
  "undo": "none"
}

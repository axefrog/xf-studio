      }
    },
    "required": [
      "fact"
    ],
    "additionalProperties": false
  },
  "capability": {
    "when": "A game with the bridge is running and the values disagree."
  },
  "effect": {
    "raises": "request:bridge-command"
  },
  "undo": "none"
}

{
  "kind": "action",
  "id": "library-import",
  "owner": "library",
  "summary": "Import (library): raises the pick-file reques.",
  "status": "both",
  "replaces": [
    "collection-service"
  ],
  "name": "import",
  "target": "type:mod",
  "input": {
    "type": "object",
    "properties": {
      "text": {
        "type": "string"
      },
      "bytes": {
        "type": "integer",
        "minimum": 0,
        "maximum": 16000000
      }
    },
    "required": [
      "text",
      "bytes"
    ],
    "additionalProperties": false
  },
  "capability": {
    "when": "The library is reachable."
  },
  "effect": {
    "raises": "request:pick-file"
  },
  "undo": "none"
}

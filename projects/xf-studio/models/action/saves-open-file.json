{
  "kind": "action",
  "id": "saves-open-file",
  "owner": "save-explorer",
  "summary": "Open file (saves): raises the pick-file request.",
  "status": "both",
  "replaces": [
    "features/save-explorer/actions"
  ],
  "name": "saves.openFile",
  "target": "type:open-save",
  "input": {
    "type": "object",
    "properties": {},
    "required": [],
    "additionalProperties": false
  },
  "capability": {
    "when": "The saves folder is known.",
    "refusals": [
      {
        "code": "folder-missing",
        "reason": "Choose where your saves are in Settings › Saves."
      }
    ]
  },
  "effect": {
    "raises": "request:pick-file"
  },
  "undo": "none"
}

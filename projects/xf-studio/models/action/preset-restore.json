{
  "kind": "action",
  "id": "preset-restore",
  "owner": "library",
  "summary": "Restore a preset from the trash.",
  "status": "target",
  "name": "preset.restore",
  "target": "type:preset-eye-makeup",
  "input": {
    "type": "object",
    "properties": {
      "preset": {
        "$ref": "shapes.schema.json#/$defs/nodeRef"
      }
    },
    "required": [
      "preset"
    ],
    "additionalProperties": false
  },
  "capability": {
    "when": "The preset is in the trash."
  },
  "effect": {
    "commit": "Restores the preset node."
  },
  "undo": "none"
}

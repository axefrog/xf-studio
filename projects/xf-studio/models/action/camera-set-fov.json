{
  "kind": "action",
  "id": "camera-set-fov",
  "owner": "views",
  "summary": "Set fov (camera): sets the camera's pose (camera.setFov), a camera jump recorded on its trail.",
  "status": "both",
  "replaces": [
    "preview-actions",
    "camera-navigation",
    "camera-framing"
  ],
  "name": "camera.setFov",
  "target": "type:camera",
  "input": {
    "type": "object",
    "properties": {
      "degrees": {
        "type": "number",
        "minimum": 10,
        "maximum": 90
      },
      "view": {
        "type": "string"
      }
    },
    "required": [
      "degrees"
    ],
    "additionalProperties": false
  },
  "capability": {
    "when": "The view exists and its scene has an orbit camera.",
    "refusals": [
      {
        "code": "no-view",
        "reason": "That view is closed."
      }
    ]
  },
  "effect": {
    "commit": "Sets the camera's pose (camera.setFov), a camera jump recorded on its trail."
  },
  "undo": "view-lighting"
}

{
  "kind": "action",
  "id": "collection-plan",
  "owner": "platform",
  "summary": "Plan (collection): raises the export-file request.",
  "status": "both",
  "replaces": [
    "studio-file-operations"
  ],
  "name": "collection.plan",
  "target": "type:window",
  "input": {
    "type": "object",
    "properties": {},
    "required": [],
    "additionalProperties": false
  },
  "capability": {
    "when": "No other picker is open in the window.",
    "refusals": [
      {
        "code": "picker-busy",
        "reason": "Another file is being picked."
      },
      {
        "code": "not-ready",
        "reason": "Build needs its settings, WolvenKit and the eye plate first."
      }
    ]
  },
  "effect": {
    "raises": "request:export-file"
  },
  "undo": "none"
}

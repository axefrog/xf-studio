{
  "kind": "action",
  "id": "wolvenkit-install",
  "owner": "setup",
  "summary": "Install (wolvenkit): raises the set-up-wolvenkit reques.",
  "status": "both",
  "replaces": [
    "wolvenkit-setup"
  ],
  "name": "wolvenkit.install",
  "target": "type:consent",
  "input": {
    "type": "object",
    "properties": {
      "version": {
        "type": "string"
      }
    },
    "required": [
      "version"
    ],
    "additionalProperties": false
  },
  "capability": {
    "when": "WolvenKit isn't usable yet, or a download is running (for cancel).",
    "refusals": [
      {
        "code": "no-consent",
        "reason": "Agree to download this WolvenKit release first."
      }
    ]
  },
  "effect": {
    "raises": "request:set-up-wolvenkit"
  },
  "undo": "none"
}

{
  "kind": "action",
  "id": "motion-set-blink",
  "owner": "motion",
  "summary": "Set blink (motion): sets the scene's motion key (motion.setBlink).",
  "status": "both",
  "replaces": [
    "motion-actions",
    "platform/core/transition-settings"
  ],
  "name": "motion.setBlink",
  "target": "type:scene",
  "input": {
    "type": "object",
    "properties": {
      "value": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "view": {
        "type": "string"
      }
    },
    "required": [
      "value"
    ],
    "additionalProperties": false
  },
  "capability": {
    "when": "The view's scene shows a V and motion is available for her body.",
    "refusals": [
      {
        "code": "motion-unavailable",
        "reason": "The installation has no creator idle for this body."
      }
    ]
  },
  "effect": {
    "commit": "Sets the scene's motion key (motion.setBlink)."
  },
  "undo": "none"
}

{
  "kind": "panel",
  "id": "lighting",
  "owner": "views",
  "summary": "Camera & light for the focused view: the setup, its lights, exposure, backdrop and display transform, what is shared with other views, and the rendering options.",
  "status": "both",
  "replaces": [
    "studio-ui/panels/preview"
  ],
  "binding": "the window's focus.view pointer (type:view)",

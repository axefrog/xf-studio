    "type:light-rig",
    "type:display",
    "type:camera",
    "operator:shared-slots",
    "operator:limits-for"
  ],
  "actions": [
    "action:preview-add-light",
    "action:preview-aim-light-at-head",
    "action:preview-create-lighting-setup",
    "action:preview-delete-lighting-setup",
    "action:preview-duplicate-light",
    "action:preview-move-light",
    "action:preview-remove-light",
    "action:preview-rename-light",
    "action:preview-rename-lighting-setup",
    "action:preview-reset-creator-lighting",
    "action:preview-reset-lighting-setup",
    "action:preview-select-lighting-setup",
    "action:preview-set-backdrop",
    "action:preview-set-body",
    "action:preview-set-creator-lighting",
    "action:preview-set-creator-shadows",
    "action:preview-set-detail",
    "action:preview-set-display-transform",
    "action:preview-set-exposure",
    "action:preview-set-eye-optics",
    "action:preview-set-eye-shape",
    "action:preview-set-face-shadows",
    "action:preview-set-hair-look",
    "action:preview-set-hair",
    "action:preview-set-key-angle",
    "action:preview-set-light-colour",
    "action:preview-set-light-shadows",
    "action:preview-set-light-type",
    "action:preview-set-light",
    "action:preview-set-lighting-preset",
    "action:preview-set-normals",
    "action:preview-set-piercings",
    "action:preview-set-room-light",
    "action:preview-set-skin-scatter",
    "action:preview-set-uncensored",
    "action:view-compare-lighting",
    "action:view-link",
    "action:view-unlink"
  ]

{
  "kind": "panel",
  "id": "help",
  "owner": "shell",
  "summary": "Help: tours, answers, shortcuts, About, Check for updates and the desktop app offer.",
  "status": "both",
  "replaces": [
    "studio-ui/guidance/desktop-app-sheet"
  ],
  "binding": "type:preferences",
  "reads": [
    "type:preferences",
    "type:tour-run",
    "request:offer-desktop-app",
    "request:check-for-release"
  ],
  "actions": [
    "action:guidance-back",
    "action:guidance-finish",
    "action:guidance-next",
    "action:guidance-skip",
    "action:guidance-start-tour",
    "action:desktop-app-install",
    "action:desktop-app-open",
    "action:desktop-app-refresh",
    "action:tours-record",
    "action:updates-check",
    "action:updates-startup-check",
    "action:updates-skip-version"
  ]
}

{
  "suite": "kernel-processes",
  "vectors": [
    {
      "name": "abort-reaches-every-descendant-and-late-results-are-discarded",
      "kind": "kernel",
      "rules": ["8.3", "9.2", "9.4", "9.5"],
      "description": "A driver's run starts process p with child q. Aborting the run at 50 ms aborts p and q with the run's reason; their work completing later is discarded.",
      "graph": { "nodes": [
        { "id": "drv", "kind": "driver", "op": "work", "params": { "processes": [
          { "id": "p", "ms": 100, "result": "p-done", "children": [ { "id": "q", "ms": 300, "result": "q-done" } ] }
        ] } }
      ] },
      "script": [ { "start": "drv", "as": "run" }, { "advance": 50 }, { "abort": "run", "reason": "stop" }, { "advance": 400 } ],
      "expect": { "processes": {
        "p": [ { "status": "running" }, { "status": "aborted", "reason": "stop" } ],
        "q": [ { "status": "running" }, { "status": "aborted", "reason": "stop" } ]
      } }
    },
    {
      "name": "a-child-ends-with-its-parent",
      "kind": "kernel",
      "rules": ["9.2", "9.5"],
      "description": "p reports progress, then finishes at 100 ms while its child q (300 ms) still runs: q is aborted with the reason { parent: done }.",
      "graph": { "nodes": [
        { "id": "drv", "kind": "driver", "op": "work", "params": { "processes": [
          { "id": "p", "ms": 100, "result": "p-done", "progress": ["half"], "children": [ { "id": "q", "ms": 300, "result": "q-done" } ] }
        ] } }
      ] },
      "script": [ { "start": "drv", "as": "run" }, { "advance": 400 } ],
      "expect": { "processes": {
        "p": [ { "status": "running" }, { "status": "progress", "progress": "half" }, { "status": "done", "result": "p-done" } ],
        "q": [ { "status": "running" }, { "status": "aborted", "reason": { "parent": "done" } } ]
      } }
    },
    {
      "name": "a-failing-process-is-a-value",
      "kind": "kernel",
      "rules": ["7.1", "9.2"],
      "description": "Work that fails ends its process in the failed state; nothing escapes.",
      "graph": { "nodes": [
        { "id": "drv", "kind": "driver", "op": "work", "params": { "processes": [ { "id": "p", "ms": 10, "fail": "disk full" } ] } }
      ] },
      "script": [ { "start": "drv", "as": "run" }, { "advance": 20 } ],
      "expect": { "processes": { "p": [ { "status": "running" }, { "status": "failed", "error": { "message": "disk full" } } ] } }
    },
    {
      "name": "an-effect-starts-and-stops-a-child-driver",
      "kind": "kernel",
      "rules": ["9.3", "9.6", "4.4"],
      "description": "While flag is true, an effect keeps driver conn running; conn's run connects an effect to a2, which activates it. When flag turns false the run is aborted, its effect disconnected, and a2 goes dormant.",
      "graph": { "nodes": [
        { "id": "flag", "kind": "seed", "initial": false },
        { "id": "a", "kind": "seed", "initial": 1 },
        { "id": "a2", "kind": "combinator", "op": "sum", "inputs": ["a"], "params": { "add": 1 } },
        { "id": "conn", "kind": "driver", "op": "connect", "params": { "pairs": [["a2", "seen"]] } },
        { "id": "w", "kind": "effect", "op": "while", "inputs": ["flag"], "params": { "driver": "conn" } }
      ] },
      "script": [ { "observe": { "a": 3 } }, { "observe": { "flag": true } }, { "observe": { "a": 5 } }, { "observe": { "flag": false } }, { "observe": { "a": 6 } } ],
      "expect": { "logs": { "seen": [[4], [6]] }, "computes": { "a2": 2 }, "active": { "a2": false } }
    }
  ]
}

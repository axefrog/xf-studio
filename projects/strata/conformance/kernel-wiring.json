{
  "suite": "kernel-wiring",
  "vectors": [
    {
      "name": "mid-cycle-rewiring-waits-for-the-cycle-end",
      "kind": "kernel",
      "rules": [
        "6.7",
        "6.8",
        "6.9"
      ],
      "description": "In one transaction sel changes (its effect rewires out from x to y) and x changes. out computes from x in that cycle; the rewiring applies when the cycle completes, and the activation cycle primes out from y. Afterwards x no longer reaches out, and x is dormant.",
      "graph": {
        "nodes": [
          {
            "id": "sel",
            "kind": "seed",
            "initial": 0
          },
          {
            "id": "x",
            "kind": "seed",
            "initial": 1
          },
          {
            "id": "y",
            "kind": "seed",
            "initial": 100
          },
          {
            "id": "out",
            "kind": "combinator",
            "op": "identity",
            "inputs": [
              "x"
            ]
          },
          {
            "id": "log",
            "kind": "effect",
            "op": "record",
            "inputs": [
              "out"
            ]
          },
          {
            "id": "rw",
            "kind": "effect",
            "op": "rewire",
            "inputs": [
              "sel"
            ],
            "params": {
              "node": "out",
              "inputs": [
                [
                  "x"
                ],
                [
                  "y"
                ]
              ]
            }
          }
        ]
      },
      "script": [
        {
          "observe": {
            "sel": 1,
            "x": 5
          }
        },
        {
          "observe": {
            "x": 7
          }
        }
      ],
      "expect": {
        "streams": {
          "out": [
            1,
            5,
            100
          ]
        },
        "computes": {
          "out": 3
        },
        "logs": {
          "log": [
            [
              1
            ],
            [
              5
            ],
            [
              100
            ]
          ]
        },
        "active": {
          "x": false,
          "y": true
        }
      }
    },
    {
      "name": "an-input-that-would-close-a-cycle-is-refused",
      "kind": "kernel",
      "rules": [
        "5.1",
        "7.4"
      ],
      "description": "Rewiring x to take y (which depends on x) would close a cycle: the change is refused, reported on the error seed with code cycle, and x keeps its input.",
      "graph": {
        "nodes": [
          {
            "id": "sel",
            "kind": "seed",
            "initial": 0
          },
          {
            "id": "a",
            "kind": "seed",
            "initial": 1
          },
          {
            "id": "x",
            "kind": "combinator",
            "op": "identity",
            "inputs": [
              "a"
            ]
          },
          {
            "id": "y",
            "kind": "combinator",
            "op": "identity",
            "inputs": [
              "x"
            ]
          },
          {
            "id": "log",
            "kind": "effect",
            "op": "record",
            "inputs": [
              "y"
            ]
          },
          {
            "id": "rw",
            "kind": "effect",
            "op": "rewire",
            "inputs": [
              "sel"
            ],
            "params": {
              "node": "x",
              "inputs": [
                [
                  "a"
                ],
                [
                  "y"
                ]
              ]
            }
          }
        ]
      },
      "script": [
        {
          "observe": {
            "sel": 1
          }
        },
        {
          "observe": {
            "a": 4
          }
        }
      ],
      "expect": {
        "logs": {
          "log": [
            [
              1
            ],
            [
              4
            ]
          ]
        },
        "errorCodes": [
          "cycle"
        ]
      }
    },
    {
      "name": "the-erector-replaces-a-changed-node-and-rewires-its-consumers",
      "kind": "kernel",
      "rules": [
        "10.3"
      ],
      "description": "A new model changes b's parameters: b is replaced, the effect reading it is rewired to the new b and primed, and later observations flow through the new b.",
      "graph": {
        "nodes": [
          {
            "id": "a",
            "kind": "seed",
            "initial": 2
          },
          {
            "id": "b",
            "kind": "combinator",
            "op": "sum",
            "inputs": [
              "a"
            ],
            "params": {
              "add": 1
            }
          },
          {
            "id": "log",
            "kind": "effect",
            "op": "record",
            "inputs": [
              "b"
            ]
          }
        ]
      },
      "script": [
        {
          "model": {
            "nodes": [
              {
                "id": "a",
                "kind": "seed",
                "initial": 2
              },
              {
                "id": "b",
                "kind": "combinator",
                "op": "sum",
                "inputs": [
                  "a"
                ],
                "params": {
                  "add": 5
                }
              },
              {
                "id": "log",
                "kind": "effect",
                "op": "record",
                "inputs": [
                  "b"
                ]
              }
            ]
          }
        },
        {
          "observe": {
            "a": 3
          }
        }
      ],
      "expect": {
        "streams": {
          "b": [
            7,
            8
          ]
        },
        "logs": {
          "log": [
            [
              3
            ],
            [
              7
            ],
            [
              8
            ]
          ]
        }
      }
    },
    {
      "name": "a-state-machine-declared-as-data",
      "kind": "kernel",
      "rules": [
        "10.6"
      ],
      "description": "A machine with a guarded transition: start does nothing until the guard input ready is true; stop returns to idle. Each transition is one entry naming its event, origin and declared effects.",
      "graph": {
        "schema": "xf-strata/graph-model/1",
        "nodes": [
          {
            "id": "start",
            "kind": "seed"
          },
          {
            "id": "stop",
            "kind": "seed"
          },
          {
            "id": "ready",
            "kind": "seed",
            "initial": false
          },
          {
            "id": "m",
            "kind": "combinator",
            "op": "state-machine",
            "inputs": [
              "start",
              "stop",
              "ready"
            ],
            "params": {
              "initial": "idle",
              "inputs": [
                "start",
                "stop",
                "ready"
              ],
              "states": {
                "idle": {
                  "on": {
                    "start": {
                      "target": "running",
                      "guard": "ready",
                      "effects": [
                        "announce"
                      ]
                    }
                  }
                },
                "running": {
                  "on": {
                    "stop": {
                      "target": "idle"
                    }
                  }
                }
              }
            }
          },
          {
            "id": "log",
            "kind": "effect",
            "op": "record",
            "inputs": [
              "m"
            ]
          }
        ]
      },
      "script": [
        {
          "observe": {
            "start": 1
          }
        },
        {
          "observe": {
            "ready": true
          }
        },
        {
          "observe": {
            "start": 1
          }
        },
        {
          "observe": {
            "stop": 1
          }
        }
      ],
      "expect": {
        "streams": {
          "m": [
            {
              "state": "idle"
            },
            {
              "state": "running",
              "from": "idle",
              "event": "start",
              "effects": [
                "announce"
              ]
            },
            {
              "state": "idle",
              "from": "running",
              "event": "stop"
            }
          ]
        }
      }
    },
    {
      "name": "a-model-in-an-unknown-format-is-refused",
      "kind": "kernel",
      "rules": [
        "10.2",
        "7.4"
      ],
      "description": "A model naming a format version this engine doesn't read is refused with code schema, and the erected graph stays as it was.",
      "graph": {
        "schema": "xf-strata/graph-model/1",
        "nodes": [
          {
            "id": "a",
            "kind": "seed",
            "initial": 1
          },
          {
            "id": "log",
            "kind": "effect",
            "op": "record",
            "inputs": [
              "a"
            ]
          }
        ]
      },
      "script": [
        {
          "model": {
            "schema": "xf-strata/graph-model/9",
            "nodes": []
          }
        },
        {
          "observe": {
            "a": 2
          }
        }
      ],
      "expect": {
        "logs": {
          "log": [
            [
              1
            ],
            [
              2
            ]
          ]
        },
        "errorCodes": [
          "schema"
        ]
      }
    }
  ]
}

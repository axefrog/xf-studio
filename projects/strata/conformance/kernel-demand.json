{
  "suite": "kernel-demand",
  "vectors": [
    {
      "name": "nothing-computes-without-demand",
      "kind": "kernel",
      "rules": ["4.1", "4.4", "5.5", "9.1"],
      "description": "sq is dormant until driver conn's run connects an effect to it; then it is primed and follows a; after the run is aborted it is dormant again and computes nothing.",
      "graph": { "nodes": [
        { "id": "a", "kind": "seed", "initial": 2 },
        { "id": "sq", "kind": "combinator", "op": "product", "inputs": ["a", "a"] },
        { "id": "conn", "kind": "driver", "op": "connect", "params": { "pairs": [["sq", "seen"]] } }
      ] },
      "script": [ { "observe": { "a": 3 } }, { "start": "conn", "as": "run" }, { "observe": { "a": 4 } }, { "abort": "run" }, { "observe": { "a": 5 } } ],
      "expect": { "streams": { "sq": [9, 16] }, "computes": { "sq": 2 }, "logs": { "seen": [[9], [16]] }, "active": { "sq": false } }
    },
    {
      "name": "a-rolling-window-moves-with-the-stream",
      "kind": "kernel",
      "rules": ["4.2", "4.6"],
      "description": "collect demands the last two entries of a, and sees them move.",
      "graph": { "nodes": [
        { "id": "a", "kind": "seed", "initial": 1 },
        { "id": "c", "kind": "combinator", "op": "collect", "inputs": ["a"], "demand": { "rolling": { "entries": 2 } } },
        { "id": "log", "kind": "effect", "op": "record", "inputs": ["c"] }
      ] },
      "script": [ { "observe": { "a": 2 } }, { "observe": { "a": 3 } }, { "observe": { "a": 4 } } ],
      "expect": { "streams": { "c": [[1], [1, 2], [2, 3], [3, 4]] } }
    },
    {
      "name": "a-demand-spec-node-resizes-the-window-without-releasing-demand",
      "kind": "kernel",
      "rules": ["4.3"],
      "description": "c's demand on a is the latest entry of the spec node. Shrinking the window from three entries to one is a new spec entry; a stays demanded throughout.",
      "graph": { "nodes": [
        { "id": "spec", "kind": "seed", "initial": { "rolling": { "entries": 3 } } },
        { "id": "a", "kind": "seed", "initial": 1 },
        { "id": "c", "kind": "combinator", "op": "collect", "inputs": ["a"], "demand": "spec" },
        { "id": "log", "kind": "effect", "op": "record", "inputs": ["c"] }
      ] },
      "script": [ { "observe": { "a": 2 } }, { "observe": { "a": 3 } }, { "observe": { "spec": { "rolling": { "entries": 1 } } } }, { "observe": { "a": 4 } } ],
      "expect": { "streams": { "c": [[1], [1, 2], [1, 2, 3], [4]] }, "active": { "a": true } }
    }
  ]
}

{
  "suite": "entity-history",
  "vectors": [
    {
      "name": "undo-compensates-exactly-and-redo-returns",
      "kind": "entity",
      "rules": ["14.1", "14.2", "14.3"],
      "description": "A commit sets a title, tombstones a key and renames. Undo appends one compensation that restores all three; redo compensates the compensation. The stream only grows.",
      "types": [ { "type": "swatch", "owner": "vectors", "schema": "1",
        "fields": { "title": { "kind": "value" }, "colours": { "kind": "map", "of": { "kind": "value" } } },
        "defaults": { "colours": { "ink": "#000" } } } ],
      "script": [
        { "commit": [ { "op": "create", "type": "swatch", "as": "a", "fields": { "title": "a", "colours": { "x": 1 } } } ] },
        { "commit": [ { "op": "set", "node": { "$label": "a" }, "path": ["title"], "value": "b" },
                      { "op": "tombstone", "node": { "$label": "a" }, "path": ["colours", "x"] },
                      { "op": "rename", "node": { "$label": "a" }, "name": "renamed" } ] },
        { "undo": "default" },
        { "redo": "default" }
      ],
      "expect": {
        "effective": { "a": { "title": "b", "colours": { "ink": "#000" } } },
        "streams": { "a": [[1, "create"], [2, "set"], [3, "tombstone"], [4, "rename"], [5, "compensate"], [6, "compensate"]] },
        "refusals": [null, null, null, null],
        "changes": [
          ["a [\"colours\",\"ink\"]", "a [\"colours\",\"x\"]", "a [\"title\"]"],
          ["a [\"colours\",\"x\"]", "a [\"title\"]"],
          ["a [\"colours\",\"x\"]", "a [\"title\"]"],
          ["a [\"colours\",\"x\"]", "a [\"title\"]"]
        ]
      }
    },
    {
      "name": "undoing-a-creation-retracts-the-node",
      "kind": "entity",
      "rules": ["11.7", "14.2"],
      "description": "Undoing a create appends retract: the node reads as absent, as before it existed. Redo brings it back.",
      "types": [ { "type": "swatch", "owner": "vectors", "schema": "1", "fields": { "title": { "kind": "value" } } } ],
      "script": [
        { "commit": [ { "op": "create", "type": "swatch", "as": "a", "fields": { "title": "a" } } ] },
        { "undo": "default" }
      ],
      "expect": { "effective": { "a": null }, "streams": { "a": [[1, "create"], [2, "compensate"]] }, "changes": [["a [\"title\"]"], ["a [\"title\"]"]] }
    },
    {
      "name": "revert-returns-to-an-earlier-entry",
      "kind": "entity",
      "rules": ["14.4"],
      "description": "Revert to entry 2 appends one revert entry whose fold is the state at entry 2.",
      "types": [ { "type": "swatch", "owner": "vectors", "schema": "1", "fields": { "title": { "kind": "value" } } } ],
      "script": [
        { "commit": [ { "op": "create", "type": "swatch", "as": "a", "fields": { "title": "v1" } } ] },
        { "commit": [ { "op": "set", "node": { "$label": "a" }, "path": ["title"], "value": "v2" } ] },
        { "commit": [ { "op": "set", "node": { "$label": "a" }, "path": ["title"], "value": "v3" } ] },
        { "commit": [ { "op": "revert", "node": { "$label": "a" }, "to": 2 } ] }
      ],
      "expect": { "effective": { "a": { "title": "v2" } }, "streams": { "a": [[1, "create"], [2, "set"], [3, "set"], [4, "revert"]] } }
    },
    {
      "name": "compaction-keeps-the-latest-and-referenced-entries-and-rolls-up-by-second",
      "kind": "entity",
      "rules": ["16.2", "16.4", "16.8"],
      "description": "Thirteen edits over 1.1 s, a tag on entry 5, then compaction (after the session's undo history ends). The run before the tagged entry becomes one state; the run after it becomes one state per second; the tag and the latest entry stay.",
      "types": [ { "type": "swatch", "owner": "vectors", "schema": "1", "stream": "delta", "fields": { "title": { "kind": "value" } } } ],
      "script": [
        { "commit": [ { "op": "create", "type": "swatch", "as": "a", "fields": { "title": "t0" } } ] },
        { "commit": [ { "op": "set", "node": { "$label": "a" }, "path": ["title"], "value": "t1" } ] }, { "advance": 100 },
        { "commit": [ { "op": "set", "node": { "$label": "a" }, "path": ["title"], "value": "t2" } ] }, { "advance": 100 },
        { "commit": [ { "op": "set", "node": { "$label": "a" }, "path": ["title"], "value": "t3" } ] }, { "advance": 100 },
        { "commit": [ { "op": "set", "node": { "$label": "a" }, "path": ["title"], "value": "t4" } ] }, { "advance": 100 },
        { "commit": [ { "op": "set", "node": { "$label": "a" }, "path": ["title"], "value": "t5" } ] }, { "advance": 100 },
        { "commit": [ { "op": "set", "node": { "$label": "a" }, "path": ["title"], "value": "t6" } ] }, { "advance": 100 },
        { "commit": [ { "op": "set", "node": { "$label": "a" }, "path": ["title"], "value": "t7" } ] }, { "advance": 100 },
        { "commit": [ { "op": "set", "node": { "$label": "a" }, "path": ["title"], "value": "t8" } ] }, { "advance": 100 },
        { "commit": [ { "op": "set", "node": { "$label": "a" }, "path": ["title"], "value": "t9" } ] }, { "advance": 100 },
        { "commit": [ { "op": "set", "node": { "$label": "a" }, "path": ["title"], "value": "t10" } ] }, { "advance": 100 },
        { "commit": [ { "op": "set", "node": { "$label": "a" }, "path": ["title"], "value": "t11" } ] }, { "advance": 100 },
        { "commit": [ { "op": "set", "node": { "$label": "a" }, "path": ["title"], "value": "t12" } ] },
        { "commit": [ { "op": "tag", "node": { "$label": "a" }, "label": "Keep this version", "entries": [ { "node": { "$label": "a" }, "seq": 5 } ] } ] },
        { "forget": "*" },
        { "compact": "a" }
      ],
      "expect": {
        "effective": { "a": { "title": "t12" } },
        "streams": { "a": [[4, "state"], [5, "set"], [11, "state"], [13, "state"], [14, "tag"]] }
      }
    },
    {
      "name": "an-older-schema-upcasts-on-read",
      "kind": "entity",
      "rules": ["15.3", "11.6"],
      "description": "Two stored entries of schema 1 (the title was called name) and one of schema 2 fold, through the declared rename, to the current type's value.",
      "types": [ { "type": "swatch", "owner": "vectors", "schema": "2",
        "fields": { "title": { "kind": "value" }, "colours": { "kind": "map", "of": { "kind": "value" } } },
        "defaults": { "colours": { "ink": "#000" } },
        "upcasters": [ { "from": "1", "to": "2", "rename": [[["name"], ["title"]]] } ] } ],
      "script": [
        { "entries": [
          { "label": "old", "node": { "type": "swatch", "id": "00000000-0000-4000-8000-000000000101" }, "seq": 1, "pos": 0, "commit": "c1", "actor": "local", "actorSeq": 1, "at": 1, "schema": "1",
            "op": { "kind": "create", "state": { "name": "Old", "own": { "[\"name\"]": "first" }, "layers": [], "trashed": false, "retracted": false } } },
          { "node": { "type": "swatch", "id": "00000000-0000-4000-8000-000000000101" }, "seq": 2, "pos": 0, "commit": "c2", "actor": "local", "actorSeq": 2, "at": 2, "schema": "1",
            "op": { "kind": "set", "path": ["name"], "value": "second" } },
          { "node": { "type": "swatch", "id": "00000000-0000-4000-8000-000000000101" }, "seq": 3, "pos": 0, "commit": "c3", "actor": "local", "actorSeq": 3, "at": 3, "schema": "2",
            "op": { "kind": "set", "path": ["colours", "n"], "value": 1 } }
        ] }
      ],
      "expect": { "effective": { "old": { "title": "second", "colours": { "ink": "#000", "n": 1 } } } }
    },
    {
      "name": "purge-is-refused-while-others-layer-from-it",
      "kind": "entity",
      "rules": ["16.7", "13.5"],
      "description": "Purging a fork's base is refused with dependents; after the fork detaches, the purge removes the base.",
      "types": [ { "type": "swatch", "owner": "vectors", "schema": "1", "fields": { "title": { "kind": "value" } } } ],
      "script": [
        { "commit": [ { "op": "create", "type": "swatch", "as": "a", "fields": { "title": "a" } } ] },
        { "commit": [ { "op": "create", "type": "swatch", "as": "f", "from": { "fork": { "$label": "a" } } } ] },
        { "purge": "a" },
        { "commit": [ { "op": "detach", "node": { "$label": "f" } } ] },
        { "purge": "a" }
      ],
      "expect": { "refusals": [null, null, "dependents", null, null], "effective": { "a": null, "f": { "title": "a" } } }
    }
  ]
}

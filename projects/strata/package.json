{
  "name": "strata",
  "version": "0.1.0",
  "description": "A layered, event-sourced node graph with deterministic simulation testing.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./testing": "./testing.ts"
  },
  "scripts": {
    "test": "bun test",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tests.json",
    "example": "bun examples/minimal",
    "bench": "bun tests/bench/load-budget.ts && bun tests/bench/compaction.ts",
    "sim:long": "bun tests/sim/long-run.ts",
    "coverage:ratchet": "bun tools/coverage.ts --ratchet",
    "mutate:ratchet": "bun tools/mutate.ts --ratchet"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  }
}

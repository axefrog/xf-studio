{
  "schema": "xfb/session-script-1",
  "name": "session-3",
  "title": "Session 3: Glitter board, blink and creator checks",
  "card": "experiments/022-session-3/README.md",
  "requires": [
    "MO2 profile 'XF Studio diagnostic 2026-09-25' with XF Eye Artistry (the experiment 021 Glitter board) and XF Runtime Bridge (-writes build, with its XF camera presets)",
    "a loaded save with V in the world, in an open spot",
    "a fresh manual safety save (step p0-ready)",
    "the game window in front (photo.open presses the photo-mode key in it)"
  ],
  "steps": [
    {
      "do": "run",
      "label": "p0-bridge",
      "command": "bridge.info"
    },
    {
      "do": "run",
      "label": "p0-status",
      "command": "game.status"
    },
    {
      "do": "ask",
      "label": "p0-ready",
      "text": "Before anything changes: (1) make a new manual save now. This profile shares your save folder, and once the bridge changes something, saving stays locked until you load a save. (2) Tell the coordinator the game version, the upscaler and mode, the resolution, and whether ray tracing or path tracing is on. (3) Check that the XF selector lists Off plus six Glitter presets. Stand V in an open, quiet spot with room in front of her (photo mode's camera needs a few metres); keep the game window in front."
    },
    {
      "do": "ask",
      "label": "a-first-open-creator",
      "text": "Open the character creator (a mirror's appearance screen, or F12 with Character Customization Anywhere) and go to the page with the XF row. Leave its camera on the eyes zoom.",
      "replaced_by": "cc.open"
    },

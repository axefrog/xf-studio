            "to": "$DI2_mark.who",
            "stop_m": 0.8
          }
        },
        {
          "label": "DI2-arrived",
          "do": "await",
          "cursor": "$DI2_cursor",
          "kind": "npc.arrived",
          "subject": "$DI2_thief.who",
          "timeout_s": 30,
          "bind": "DI2_arrived"
        },
        {
          "label": "DI2-line",
          "do": "run",
          "command": "npc.say",
          "input": {
            "who": "$DI2_thief.who",
            "text": "(lifts the wallet)",
            "style": "overhead",
            "seconds": 3
          }
        },
        {
          "label": "DI2-turn",
          "do": "run",
          "command": "npc.turn",
          "input": {
            "who": "$DI2_thief.who",
            "to": "v"
          },

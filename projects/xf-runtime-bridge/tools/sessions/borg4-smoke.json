{
  "schema": "xfb/session-script-3",
  "name": "borg4-smoke",
  "title": "Borg 4 regression smoke: B318-1, B318-3, B318-4, CS8181, DI2, DI3, CRS",
  "card": "research/runtime/runtime-bridge-test-card.md#borg-3-regressions-0818",
  "requires": [
    "The XF test profile with the -writes build; V in an open, quiet street with crowd walkers about; a throwaway save.",
    "A private fixtures file (--fixtures) as for st-styling (mo2, game_dir, staged_mod, save)."
  ],
  "setup": [
    {
      "label": "commit",
      "do": "host.commit",
      "on_fail": "stop"
    }
  ],
  "rows": [
    {
      "id": "B318-1",
      "title": "No invalid heartbeats over the whole batch: every channel's samples valid, no coverage gaps (passive, judged at the end)",
      "passive": "whole-batch",
      "steps": [
        {
          "label": "B318-1-telemetry",
          "do": "set",
          "value": "$telemetry",
          "bind": "B318_1_all"
        }
      ],
      "pass": [
        {
          "label": "the recorder ran and was read",
          "ref": "$B318_1_all.runs.0",
          "match": {
            "exists": true
          }
        },
        {
          "label": "every page read (no catch-up refused)",
          "ref": "$B318_1_all.unread",
          "match": {
            "equals": []
          }
        },
        {
          "label": "no invalid samples",
          "ref": "$B318_1_all.coverage.invalid",
          "match": {
            "equals": 0
          }
        },
        {
          "label": "subtitles: no invalid samples",
          "ref": "$B318_1_all",
          "match": {
            "any": [
              {
                "path": "channels.subtitles.invalid",
                "equals": 0
              },
              {
                "path": "channels.subtitles",
                "exists": false
              }
            ]
          }
        },
        {
          "label": "voice: no invalid samples",
          "ref": "$B318_1_all",
          "match": {
            "any": [
              {
                "path": "channels.voice.invalid",
                "equals": 0
              },
              {
                "path": "channels.voice",
                "exists": false
              }
            ]
          }
        },
        {
          "label": "face: no invalid samples",
          "ref": "$B318_1_all",
          "match": {
            "any": [
              {
                "path": "channels.face.invalid",
                "equals": 0
              },
              {
                "path": "channels.face",
                "exists": false
              }
            ]
          }
        },
        {
          "label": "ui: no invalid samples",
          "ref": "$B318_1_all",
          "match": {
            "any": [
              {
                "path": "channels.ui.invalid",
                "equals": 0
              },
              {
                "path": "channels.ui",
                "exists": false
              }
            ]
          }
        },
        {
          "label": "no gaps",
          "ref": "$B318_1_all.gaps",
          "match": {
            "equals": []
          }
        }
      ],
      "facts": [
        {
          "label": "runs",
          "ref": "$B318_1_all.runs"
        },
        {
          "label": "pages",
          "ref": "$B318_1_all.pages"
        },
        {
          "label": "gaps",
          "ref": "$B318_1_all.gaps"
        },
        {
          "label": "coverage loss",
          "ref": "$B318_1_all.coverage"
        },
        {
          "label": "invalid samples by row",
          "ref": "$B318_1_all.invalid_in"
        },
        {
          "label": "gaps by row",
          "ref": "$B318_1_all.gaps_in"
        }
      ]
    },
    {
      "id": "B318-3",
      "title": "phone.call auto_answer: answered with no key press, the call ends by itself",
      "requires": [
        {
          "config": "bridge.allow_writes",
          "equals": "true"
        }
      ],
      "steps": [
        {
          "label": "B318-3-play",
          "do": "run",
          "command": "game.wait",
          "input": {
            "phase": "gameplay",
            "timeout_ms": 20000
          },
          "deadline_ms": 25000,
          "alternatives": [
            [
              {
                "do": "run",
                "command": "photo.exit",
                "input": {}
              },
              {
                "do": "run",
                "command": "game.wait",
                "input": {
                  "phase": "gameplay",
                  "timeout_ms": 20000
                },
                "deadline_ms": 25000
              }
            ]
          ]
        },
        {
          "label": "B318-3-cursor",
          "do": "cursor",
          "bind": "B318_3_cursor"
        },
        {
          "label": "B318-3-call",
          "do": "run",
          "command": "phone.call",
          "input": {
            "contact": "coach",
            "auto_answer": true,
            "ring_s": 30,
            "lines": [
              {
                "text": "Smoke check: this call answers itself."
              }
            ],
            "when": {
              "phase": "gameplay",
              "combat": false,
              "vehicle": false
            }
          },
          "bind": "B318_3_call",
          "retry": {
            "times": 3,
            "backoff_ms": 5000,
            "on": {
              "code": "precondition_failed"
            }
          }
        },
        {
          "label": "B318-3-window",
          "do": "events",
          "cursor": "$B318_3_cursor",
          "duration_s": 25,
          "bind": "B318_3_window"
        },
        {
          "label": "B318-3-state",
          "do": "run",
          "command": "phone.state",
          "input": {},
          "bind": "B318_3_state"
        }
      ],
      "pass": [
        {
          "label": "answered by the bridge, this call",
          "ref": "$B318_3_window",
          "match": {
            "path": "events",
            "some": {
              "all": [
                {
                  "path": "kind",
                  "equals": "dm.phone"
                },
                {
                  "path": "data.what",
                  "equals": "auto_answer"
                },
                {
                  "path": "data.call",
                  "equals": "$B318_3_call.call"
                }
              ]
            }
          }
        },
        {
          "label": "ended by itself, this call",
          "ref": "$B318_3_window",
          "match": {
            "all": [
              {
                "path": "events",
                "some": {
                  "all": [
                    {
                      "path": "kind",
                      "equals": "dm.phone"
                    },
                    {
                      "path": "data.what",
                      "equals": "ended"
                    },
                    {
                      "path": "data.call",
                      "equals": "$B318_3_call.call"
                    }
                  ]
                }
              },
              {
                "not": {
                  "path": "events",
                  "some": {
                    "all": [
                      {
                        "path": "data.call",
                        "equals": "$B318_3_call.call"
                      },
                      {
                        "path": "data.what",
                        "one_of": [
                          "missed",
                          "declined",
                          "failed",
                          "hung_up"
                        ]
                      }
                    ]
                  }
                }
              }
            ]
          }
        }
      ],
      "cleanup": [
        {
          "label": "B318-3-end",
          "do": "run",
          "command": "phone.end",
          "input": {}
        }
      ]
    },
    {
      "id": "B318-4",
      "title": "The XF panel hides while the call widget is up",
      "requires": [
        {
          "config": "bridge.allow_writes",
          "equals": "true"
        }
      ],
      "steps": [
        {
          "label": "B318-4-play",
          "do": "run",
          "command": "game.wait",
          "input": {
            "phase": "gameplay",
            "timeout_ms": 20000
          },
          "deadline_ms": 25000,
          "alternatives": [
            [
              {
                "do": "run",
                "command": "photo.exit",
                "input": {}
              },
              {
                "do": "run",
                "command": "game.wait",
                "input": {
                  "phase": "gameplay",
                  "timeout_ms": 20000
                },
                "deadline_ms": 25000
              }
            ]
          ]
        },
        {
          "label": "B318-4-panel",
          "do": "run",
          "command": "ui.hud",
          "input": {
            "show": true
          }
        },
        {
          "label": "B318-4-call",
          "do": "run",
          "command": "phone.call",
          "input": {
            "contact": "coach",
            "auto_answer": false,
            "ring_s": 20,
            "lines": [
              {
                "text": "Smoke check: ringing."
              }
            ],
            "when": {
              "phase": "gameplay",
              "combat": false,
              "vehicle": false
            }
          },
          "retry": {
            "times": 3,
            "backoff_ms": 5000,
            "on": {
              "code": "precondition_failed"
            }
          }
        },
        {
          "label": "B318-4-ringing",
          "do": "run",
          "command": "ui.state",
          "input": {},
          "until": {
            "path": "phone_open",
            "equals": true
          },
          "interval_ms": 500,
          "deadline_ms": 10000,
          "bind": "B318_4_ui",
          "on_fail": "fail_row"
        },
        {
          "label": "B318-4-shot",
          "do": "capture",
          "name": "B318-4-ringing",
          "clear_overlay": false,
          "bind": "B318_4_shot"
        }
      ],
      "pass": [
        {
          "label": "phone_open while ringing",
          "ref": "$B318_4_ui.phone_open",
          "match": {
            "equals": true
          }
        },
        {
          "label": "the ringing widget, uncovered",
          "ref": "$B318_4_shot",
          "captured": true
        }
      ],
      "cleanup": [
        {
          "label": "B318-4-end",
          "do": "run",
          "command": "phone.end",
          "input": {}
        },
        {
          "label": "B318-4-hud-back",
          "do": "run",
          "command": "ui.hud",
          "input": {
            "reset": true
          }
        }
      ]
    },
    {
      "id": "CS8181",
      "title": "A hostile melee fighter engages by itself",
      "requires": [
        {
          "config": "bridge.allow_writes",
          "equals": "true"
        }
      ],
      "steps": [
        {
          "label": "CS8181-play",
          "do": "run",
          "command": "game.wait",
          "input": {
            "phase": "gameplay",
            "timeout_ms": 20000
          },
          "deadline_ms": 25000,
          "alternatives": [
            [
              {
                "do": "run",
                "command": "photo.exit",
                "input": {}
              },
              {
                "do": "run",
                "command": "game.wait",
                "input": {
                  "phase": "gameplay",
                  "timeout_ms": 20000
                },
                "deadline_ms": 25000
              }
            ]
          ]
        },
        {
          "label": "CS8181-health",
          "do": "run",
          "command": "player.status",
          "input": {},
          "bind": "CS8181_before"
        },
        {
          "label": "CS8181-cursor",
          "do": "cursor",
          "bind": "CS8181_cursor"
        },
        {
          "label": "CS8181-spawn",
          "do": "run",
          "command": "npc.spawn",
          "input": {
            "cast": "fighter_melee",
            "ahead_m": 8,
            "attitude": "hostile",
            "reactions": "game"
          },
          "bind": "CS8181_fighter",
          "alternatives": [
            [
              {
                "do": "run",
                "command": "npc.spawn",
                "input": {
                  "cast": "fighter_melee",
                  "ahead_m": 6,
                  "attitude": "hostile",
                  "reactions": "game"
                },
                "bind": "CS8181_fighter"
              }
            ]
          ]
        },
        {
          "label": "CS8181-engaged",
          "do": "await",
          "cursor": "$CS8181_cursor",
          "kind": "npc.handed_back",
          "subject": "$CS8181_fighter.who",
          "timeout_s": 30,
          "bind": "CS8181_engaged",
          "on_fail": "fail_row"
        }
      ],
      "pass": [
        {
          "label": "handed back to the game's combat",
          "ref": "$CS8181_engaged.complete",
          "match": {
            "equals": true
          }
        }
      ],
      "cleanup": [
        {
          "label": "CS8181-release",
          "do": "run",
          "command": "npc.release",
          "input": {
            "who": "$CS8181_fighter.who",
            "how": "despawn"
          },
          "when": {
            "match": {
              "ref": "$CS8181_fighter",
              "exists": true
            }
          }
        }
      ]
    },
    {

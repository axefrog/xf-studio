        {
          "label": "DI2-close",
          "do": "run",
          "command": "incidents.close",
          "input": {
            "id": "$DI2_declared.id"
          },
          "bind": "DI2_closed"
        },
        {
          "label": "DI2-list",
          "do": "run",
          "command": "incidents.list",
          "input": {
            "declared": true,
            "limit": 8
          },
          "bind": "DI2_list"
        }
      ],
      "pass": [
        {
          "label": "closed with a report",
          "ref": "$DI2_closed.outcome",

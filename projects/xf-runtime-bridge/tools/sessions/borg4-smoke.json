    },
    {
      "id": "CRS",
      "title": "Crowd substitution out of view, then released with restore",
      "requires": [
        {
          "config": "bridge.allow_writes",
          "equals": "true"
        }
      ],
      "steps": [
        {
          "label": "CRS-play",
          "do": "run",
          "command": "game.wait",
          "input": {
            "phase": "gameplay",
            "timeout_ms": 20000
          },
          "deadline_ms": 25000,
          "alternatives": [
            [
              {
                "do": "run",
                "command": "photo.exit",
                "input": {}
              },
              {
                "do": "run",
                "command": "game.wait",
                "input": {
                  "phase": "gameplay",
                  "timeout_ms": 20000
                },
                "deadline_ms": 25000
              }
            ]
          ]
        },
        {
          "label": "CRS-list",
          "do": "run",
          "command": "npc.list",
          "input": {
            "radius_m": 30
          },
          "bind": "CRS_crowd"
        },
        {
          "label": "CRS-cursor",
          "do": "cursor",
          "bind": "CRS_cursor"
        },
        {
          "label": "CRS-swap",
          "do": "run",
          "command": "npc.substitute",
          "input": {
            "look_at": true
          },
          "bind": "CRS_swap",
          "alternatives": [
            [
              {
                "do": "run",
                "command": "player.look",
                "input": {
                  "yaw": 90,
                  "relative": true,
                  "when": {
                    "phase": "gameplay",
                    "combat": false,
                    "vehicle": false
                  }
                }
              },
              {
                "do": "wait",
                "ms": 1500
              },
              {
                "do": "run",
                "command": "npc.substitute",
                "input": {
                  "look_at": true
                },
                "bind": "CRS_swap"
              }
            ]
          ],
          "outcomes": [
            {
              "name": "nobody_suitable",
              "match": {
                "code": [
                  "no_target",
                  "not_found",
                  "too_far",
                  "npc_busy",
                  "npc_protected"
                ]
              },
              "result": "fail"
            }
          ]
        },
        {
          "label": "CRS-swapped",
          "do": "await",
          "cursor": "$CRS_cursor",
          "kind": "npc.substituted",
          "subject": "$CRS_swap.who",
          "timeout_s": 20,
          "bind": "CRS_swapped",
          "on_fail": "fail_row"
        },
        {
          "label": "CRS-release",
          "do": "run",
          "command": "npc.release",
          "input": {
            "who": "$CRS_swap.who",
            "how": "despawn",
            "restore": true
          },
          "bind": "CRS_released"
        }
      ],
      "pass": [
        {
          "label": "swapped",
          "ref": "$CRS_swapped.complete",
          "match": {
            "equals": true
          }
        }
      ],
      "cleanup": [
        {
          "label": "CRS-cleanup",
          "do": "run",
          "command": "npc.release",
          "input": {
            "who": "$CRS_swap.who",
            "how": "despawn"
          },
          "when": {
            "match": {
              "all": [
                {
                  "ref": "$CRS_swap",
                  "exists": true
                },
                {
                  "ref": "$CRS_released",
                  "exists": false
                }
              ]
            }
          }
        }
      ]
    }
  ],
  "teardown": []
}

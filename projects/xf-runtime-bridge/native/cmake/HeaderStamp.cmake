# Writes a stamp of every header under src/ into a generated header on every build (0.8.2). Each translation unit that
# includes core/LayoutGuard.hpp records the stamp it was compiled against (#pragma detect_mismatch), so linking an object
# file compiled against older headers fails with LNK2038 instead of producing a DLL whose parts disagree on a class's layout.
#
# Why: 0.8.1's DLL linked a Main.obj compiled before Bridge gained its control pipe. It allocated 0x2F8 bytes for a Bridge
# whose constructor wrote 0x428, and the overrun corrupted the process heap at the game's start (three crashes in three
# launches). The incremental build had no include record for Main.cpp, so the header change never reached it.
#
#   cmake -DSOURCE_DIR=<native/src> -DOUTPUT=<header> -P HeaderStamp.cmake
#
# The header is rewritten only when the stamp changes, so unchanged headers don't rebuild anything.

file(GLOB_RECURSE headers LIST_DIRECTORIES false RELATIVE "${SOURCE_DIR}" "${SOURCE_DIR}/*.hpp" "${SOURCE_DIR}/*.h")
list(SORT headers)
set(digest "")
foreach(header IN LISTS headers)
  file(SHA256 "${SOURCE_DIR}/${header}" one)
  string(APPEND digest "${header}=${one}\n")
endforeach()
string(SHA256 stamp "${digest}")
string(SUBSTRING "${stamp}" 0 32 stamp)

set(content "#pragma once\n// Generated by native/cmake/HeaderStamp.cmake on every build. Do not edit.\n#define XFB_HEADER_STAMP \"${stamp}\"\n")
if(EXISTS "${OUTPUT}")
  file(READ "${OUTPUT}" existing)
else()
  set(existing "")
endif()
if(NOT existing STREQUAL content)
  file(WRITE "${OUTPUT}" "${content}")
endif()

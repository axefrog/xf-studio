// Version resource so the framework check and Windows can read the plugin version.
#include <winres.h>

#define XFB_RC_VERSION XFB_VERSION_MAJOR, XFB_VERSION_MINOR, XFB_VERSION_PATCH, 0

VS_VERSION_INFO VERSIONINFO
 FILEVERSION XFB_RC_VERSION
 PRODUCTVERSION XFB_RC_VERSION
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "XF Studio"
            VALUE "FileDescription", "XF Runtime Bridge (RED4ext plugin)"
            VALUE "FileVersion", XFB_VERSION_STRING
            VALUE "ProductName", "XF Runtime Bridge"
            VALUE "ProductVersion", XFB_VERSION_STRING
            VALUE "OriginalFilename", "XFRuntimeBridge.dll"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <WolvenKitDir Condition="'$(WolvenKitDir)' == ''">F:/Games/RedModding/WolvenKit.Console</WolvenKitDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(WolvenKitDir)/*.dll" Exclude="$(WolvenKitDir)/wwtools.dll;$(WolvenKitDir)/System.Diagnostics.EventLog.Messages.dll" />
    <Content Include="$(WolvenKitDir)/appsettings.json" Link="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

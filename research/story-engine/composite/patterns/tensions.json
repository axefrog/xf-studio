    {
      "id": "xf.composite:coveted",
      "type": "pattern",
      "version": 1,
      "family": "tension",
      "scale": "goal",
      "summary": "Someone wants a thing that someone else holds. Told as an offer, this is the fetch errand; it is one form among many.",
      "roles": {
        "?w": {"kind": "actor", "note": "who wants it"},
        "?h": {"kind": "actor", "note": "who holds it"},
        "?x": {"kind": ["item", "place", "person"], "note": "the thing"},
        "?agent": {"kind": "person", "v": "may", "note": "someone asked to get it"},
        "?other": {"kind": "actor", "note": "a third party who ends up with it"}
      },

      "entry": ["round1"],
      "outcomes": {
        "truce": {"reached": ["truce"], "kind": "resolved", "next": ["xf.composite:payoff"]},
        "foul": {
          "reached": ["foul"],
          "kind": "resolved",
          "next": ["xf.composite:grievance", "xf.composite:feud", "xf.composite:misattribution"]
        },
        "answered": {"reached": ["round2"], "kind": "resolved", "next": ["xf.composite:rivalry"]}
      },
      "within": {"clock": "game", "days": 21},
      "once": ["?a", "?b"],
      "show": {"junctures": ["round1"], "edges": 1},
      "escalation": ["foul"],
      "links": {
        "chains": ["xf.composite:grievance", "xf.composite:feud", "xf.composite:misattribution"],
        "layers": ["xf.composite:squeeze", "xf.composite:ambition-vs-obligation", "xf.composite:secret"],
        "refines": {}
      },
      "traces": ["d02.BND-33", "d02.BND-13", "d01.DRV-05", "d01.DRV-43", "d08.GRW-10", "d20.AGT-01"],
      "risks": [
        {
          "failure": "fail:recast-package",
          "note": "Same-shaped rivalries everywhere (GRW-10). The prize and the audience must differ from one rivalry to the next."
        },
        {
          "failure": "fail:runaway-escalation",
          "note": "Most rivalries stay contests. A foul is a rung: it needs pull and a wanting actor."
        },
        {
          "failure": "fail:cast-concentration",
          "note": "Neighbours tie densely, so one popular stallholder can end up in every rivalry."
        }
      ]
    },
    {

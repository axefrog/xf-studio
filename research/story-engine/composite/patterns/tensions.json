{
  "id": "xf.composite:family.tensions",
  "type": "pattern-family",
  "family": "tension",
  "version": 1,
  "status": "v0, 25 October 2026. Tensions: lasting states between people and groups that open threads. Form: pattern-language.md §3.7. Every role is open.",
  "patterns": [
    {
      "id": "xf.composite:debt",
      "type": "pattern",
      "version": 1,
      "family": "tension",
      "scale": "concern",
      "summary": "Someone owes someone else, and the debt comes due.",
      "roles": {"?d": {"kind": "actor", "note": "the debtor"}, "?c": {"kind": "actor", "note": "the creditor"}},
      "junctures": {
        "owed": {"fn": "obligate", "args": {"debtor": "?d", "creditor": "?c"}},
        "due": {
          "fn": "want",
          "args": {"who": "?c", "what": "owed"},
          "changes": [{"frame": {"of": "?c", "toward": "owed", "status": "opens"}}]
        },
        "called": {"fn": "demand", "args": {"by": "?c", "of": "?d", "what": "owed"}, "realise": [{"wait": true}, {"nudge": {}}]},
        "paid": {
          "fn": "repay",
          "args": {"debtor": "?d", "creditor": "?c"},
          "park": true,
          "v": "offer",
          "realise": [{"wait": true}, {"offer": {}}, {"refine": {"pattern": "xf.composite:sacrifice"}}],
          "changes": [
            {"ends": "obligate", "args": {"debtor": "?d", "creditor": "?c"}},
            {"tie": {"a": "?c", "b": "?d"}, "move": "up"}
          ]
        },
        "defaulted": {
          "fn": "wrong",
          "args": {"by": "?d", "to": "?c"},
          "form": "state",
          "changes": [{"belief": {"who": "?c", "about": "?d"}, "move": "forms"}, {"tie": {"a": "?c", "b": "?d"}, "move": "down"}]
        }
      },
      "edges": [
        {"from": "owed", "to": "due", "link": "enables"},
        {"from": "due", "to": "called", "link": "motive", "shown": "must"},
        {"from": "called", "to": "paid", "link": "answers"},
        {"from": "called", "to": "defaulted", "link": "answers"},
        {"from": "paid", "to": "defaulted", "link": "forecloses"}
      ],
      "entry": ["owed", "called"],
      "outcomes": {
        "settled": {"reached": ["paid"], "kind": "resolved", "next": ["xf.composite:payoff"]},
        "broken": {
          "reached": ["defaulted"],
          "kind": "failed",
          "next": ["xf.composite:grievance", "xf.composite:escalation", "xf.composite:settlement"]
        }
      },
      "within": {"clock": "game", "days": 30},
      "once": ["?d", "?c"],
      "show": {"junctures": ["called"], "edges": 1},
      "links": {
        "chains": ["xf.composite:grievance", "xf.composite:settlement", "xf.composite:payoff"],
        "layers": [
          "xf.composite:divided-loyalty",
          "xf.composite:squeeze",
          "xf.composite:ambition-vs-obligation",
          "xf.composite:protection"
        ],
        "refines": {"paid": ["xf.composite:sacrifice"]}
      },
      "traces": [
        "d01.DRV-19",
        "d01.DRV-20",
        "d01.DRV-15",
        "d01.DRV-12",
        "d01.DRV-03",
        "d02.BND-04",
        "d04.QST-05",
        "d06.TEL-05",
        "d15.NRM-06"
      ],
      "risks": [
        {
          "failure": "fail:recast-package",
          "note": "Debts that are always money read alike. Vary the currency (a favour returned, a promise, a member's dues) and what the creditor is to the debtor."
        },
        {
          "failure": "fail:puppet",
          "note": "A creditor who calls the debt for no reason: `due` is a want with a recorded cause, such as the creditor's own shortfall."
        },
        {"failure": "fail:presumed-protagonist", "note": "The protagonist owes only what an accepted offer named."}
      ]
    },
    {
      "id": "xf.composite:divided-loyalty",
      "type": "pattern",
      "version": 1,
      "family": "tension",
      "scale": "concern",
      "summary": "One membership demands what another tie forbids, and the person in the middle must answer.",
      "roles": {
        "?m": {"kind": "person", "note": "the one in the middle"},
        "?g1": {"kind": "actor", "note": "who demands: a gang, a boss, a family head"},
        "?x": {"kind": "actor", "note": "who the demand would hurt, and whom ?m protects"},
        "?lost": {"kind": "actor", "note": "whichever tie ?m loses: ?g1 or ?x"},
        "?p": {
          "kind": "person",
          "v": "may",
          "note": "someone drawn in: hired for the deed, asked to protect, asked to go between"
        }
      },
      "junctures": {
        "dutyA": {"fn": "obligate", "args": {"debtor": "?m", "creditor": "?g1"}},
        "dutyB": {"fn": "protect", "args": {"guard": "?m", "ward": "?x"}},
        "order": {
          "fn": "demand",
          "args": {"by": "?g1", "of": "?m", "what": "?x"},
          "requires": [{"rel": "violates", "args": ["order", "dutyB"]}]
        },
        "drawn": {"fn": "ask", "args": {"by": "?m", "of": "?p", "what": "?x"}, "optional": true, "realise": [{"offer": {}}]},
        "complied": {"fn": "wrong", "args": {"by": "?m", "to": "?x"}, "optional": true, "realise": [{"wait": true}]},
        "refused": {"fn": "refuse", "args": {"who": "?m", "to": "?g1"}, "optional": true, "realise": [{"wait": true}]},
        "warned": {
          "fn": "expose",
          "args": {"by": "?m", "what": "order", "to": "?x"},
          "optional": true,
          "realise": [{"wait": true}]
        },
        "fallout": {
          "fn": "sever",
          "args": {"a": "?m", "b": "?lost"},
          "optional": true,
          "park": true,
          "changes": [{"member": {"who": "?m", "of": "?g1"}, "move": "strained"}]
        }
      },
      "edges": [
        {"from": "dutyA", "to": "order", "link": "enables"},
        {"from": "dutyB", "to": "order", "link": "enables"},
        {"from": "order", "to": "drawn", "link": "motive"},
        {"from": "order", "to": "complied", "link": "answers", "shown": "must"},
        {"from": "order", "to": "refused", "link": "answers", "shown": "must"},
        {"from": "order", "to": "warned", "link": "reveals", "shown": "must"},
        {"from": "complied", "to": "refused", "link": "forecloses"},
        {"from": "refused", "to": "complied", "link": "forecloses"},
        {"from": "complied", "to": "fallout", "link": "because"},
        {"from": "refused", "to": "fallout", "link": "because"}
      ],
      "entry": ["order"],
      "outcomes": {
        "complied": {"reached": ["complied"], "kind": "resolved", "next": ["xf.composite:grievance", "xf.composite:loss"]},
        "refused": {
          "reached": ["refused"],
          "kind": "resolved",
          "next": ["xf.composite:escalation", "xf.composite:test-of-creed"]
        },
        "warned": {"reached": ["warned"], "kind": "resolved", "next": ["xf.composite:betrayal", "xf.composite:secret"]}
      },
      "within": {"clock": "game", "days": 10},
      "once": ["?m", "?x"],
      "show": {"junctures": ["order"], "edges": 1},
      "links": {
        "chains": ["xf.composite:secret", "xf.composite:betrayal", "xf.composite:grievance", "xf.composite:escalation"],
        "layers": ["xf.composite:debt", "xf.composite:protection", "xf.composite:squeeze"],
        "refines": {}
      },
      "traces": ["DS-61", "d15.DEF-01", "d15.DEF-05", "d02.BND-35", "d01.DRV-25", "d01.DRV-30", "d09.AGY-18", "d04.QST-21"],
      "risks": [
        {
          "failure": "fail:puppet",
          "note": "An order with no group intention or leader's frame behind it. The demand comes from S1's group state or a Dilemma, never from the director."
        },
        {
          "failure": "fail:cliche",
          "note": "Most cross-pressure is lived without a break (DEF-01): delay, fake compliance and quiet warnings should outnumber open defiance."
        },
        {
          "failure": "fail:presumed-protagonist",
          "note": "The protagonist is drawn in only by an offer, and never makes ?m's choice."
        }
      ]
    },
    {
      "id": "xf.composite:secret",
      "type": "pattern",
      "version": 1,
      "family": "tension",
      "scale": "concern",
      "summary": "Someone keeps something from someone it matters to, and others may come to know.",
      "roles": {
        "?k": {"kind": "actor", "note": "the keeper"},
        "?u": {
          "kind": "actor",
          "note": "the one kept in the dark; may be the protagonist, for whom `out` is filled by exposure",
          "v": "may"
        },
        "?f": {"kind": ["fact", "event"], "note": "what is kept"},
        "?w": {"kind": "actor", "note": "a third who learns it"},
        "?t": {"kind": "actor", "v": "may", "note": "who tells ?u in the end"}
      },
      "junctures": {
        "hidden": {
          "fn": "conceal",
          "args": {"who": "?k", "what": "?f", "from": "?u"},
          "requires": [{"rel": "concerns", "args": ["?f", "?u"]}]
        },
        "spread": {
          "fn": "learn",
          "args": {"who": "?w", "what": "?f"},
          "optional": true,
          "requires": [{"rel": "distinct", "args": ["?w", "?k"]}, {"rel": "distinct", "args": ["?w", "?u"]}]
        },
        "leverage": {
          "fn": "demand",
          "args": {"by": "?w", "of": "?k", "what": "?f"},
          "optional": true,
          "changes": [{"begins": "obligate", "args": {"debtor": "?k", "creditor": "?w"}}]
        },
        "out": {
          "fn": "expose",
          "args": {"by": "?t", "what": "?f", "to": "?u"},
          "park": true,
          "realise": [{"wait": true}, {"offer": {}}, {"refine": {"pattern": "xf.composite:revelation"}}],
          "changes": [{"belief": {"who": "?u", "about": "?f"}, "move": "revised"}]
        },
        "aftermath": {"fn": "sever", "args": {"a": "?u", "b": "?k"}, "optional": true}
      },
      "edges": [
        {"from": "hidden", "to": "spread", "link": "enables"},
        {"from": "spread", "to": "leverage", "link": "motive"},
        {"from": "hidden", "to": "out", "link": "enables"},
        {"from": "out", "to": "aftermath", "link": "because", "shown": "must"}
      ],
      "entry": ["hidden"],
      "outcomes": {
        "exposed": {
          "reached": ["out"],
          "kind": "resolved",
          "next": ["xf.composite:grievance", "xf.composite:betrayal", "xf.composite:misattribution"]
        },
        "bought": {
          "reached": ["leverage"],
          "after": {"clock": "game", "days": 14},
          "kind": "parked",
          "next": ["xf.composite:debt"]
        }
      },
      "within": {"clock": "game", "days": 45},
      "once": ["?k", "?u"],
      "show": {"junctures": ["hidden"], "edges": 1},
      "links": {
        "chains": ["xf.composite:revelation", "xf.composite:betrayal", "xf.composite:misattribution", "xf.composite:debt"],
        "layers": ["xf.composite:divided-loyalty", "xf.composite:rivalry"],
        "refines": {"out": ["xf.composite:revelation"]}
      },
      "traces": [
        "DS-07",
        "DS-64",
        "d06.TEL-09",
        "d13.CUR-01",
        "d13.CUR-03",
        "d13.SRC-01",
        "d04.QST-31",
        "d10.PAY-16",
        "d15.AGT-05",
        "d15.MND-01",
        "d15.MND-02"
      ],
      "risks": [
        {
          "failure": "fail:invisible-cascade",
          "note": "A secret the protagonist has no anchor in is no gap (CUR-01). The protagonist must perceive `hidden` before `out` is worth anything."
        },
        {
          "failure": "fail:twist-without-anchor",
          "note": "An exposure of something nobody had reason to wonder about reads as noise."
        },
        {"failure": "fail:coincidence", "note": "Whoever learns the secret needs a recorded route to it."}
      ]
    },
    {
      "id": "xf.composite:rivalry",
      "type": "pattern",
      "version": 1,
      "family": "tension",
      "scale": "concern",
      "summary": "Two people who are alike and near each other compete for the same thing.",
      "roles": {
        "?a": {"kind": "actor", "note": "who wins the first round"},
        "?b": {"kind": "actor", "note": "who loses it"},
        "?p": {
          "kind": ["person", "place", "item", "fact"],
          "note": "the prize: a customer base, a spot, a boss's favour, a person's regard, standing in an audience"
        }
      },
      "junctures": {
        "round1": {
          "fn": "compete",
          "args": {"a": "?a", "b": "?b", "prize": "?p"},

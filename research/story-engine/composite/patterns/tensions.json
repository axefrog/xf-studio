      "show": {"junctures": ["approach"], "edges": 1},
      "escalation": ["counter"],
      "links": {
        "chains": ["xf.composite:grievance", "xf.composite:feud", "xf.composite:sacrifice"],
        "layers": ["xf.composite:squeeze", "xf.composite:debt", "xf.composite:divided-loyalty"],
        "refines": {}
      },
      "traces": ["d01.DRV-41", "d01.DRV-38", "d02.BND-35", "d07.DIR-41", "d09.AGY-22", "d15.ORD-01", "d15.ORD-02"],
      "risks": [
        {
          "failure": "fail:learned-grammar",

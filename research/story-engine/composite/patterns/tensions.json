        {"from": "approach", "to": "struck", "link": "enables"},
        {"from": "struck", "to": "counter", "link": "motive"},
        {"from": "struck", "to": "failed", "link": "because"},
        {"from": "answer", "to": "failed", "link": "forecloses"}
